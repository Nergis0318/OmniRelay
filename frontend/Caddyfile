:80 {
	root * /usr/share/caddy

	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy localhost:8080 {
			flush_interval -1
		}
	}

	@v1 path /v1 /v1/*
	handle @v1 {
		reverse_proxy localhost:8080 {
			flush_interval -1
		}
	}

	@provider_api path_regexp provider_api ^/[^/]+/(v1|v1beta|api)(/|$)
	handle @provider_api {
		reverse_proxy localhost:8080 {
			flush_interval -1
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
