:80 {
	root * /usr/share/caddy
	file_server

	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy /admin* backend:8080 {
		flush_interval -1
	}

	reverse_proxy /v1* backend:8080 {
		flush_interval -1
	}

	@provider-api {
		path_regexp ^/[^/]+/(v1|v1beta|api)(/|$)
	}
	reverse_proxy @provider-api backend:8080 {
		flush_interval -1
	}

	try_files {path} /index.html
}
