:80 {
	root * /usr/share/caddy
	file_server

	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	@admin path /admin /admin/*
	reverse_proxy @admin {
		to localhost:8080
		flush_interval -1
	}

	@v1 path /v1 /v1/*
	reverse_proxy @v1 {
		to localhost:8080
		flush_interval -1
	}

	@provider-api {
		path_regexp ^/[^/]+/(v1|v1beta|api)(/|$)
	}
	reverse_proxy @provider-api {
		to localhost:8080
		flush_interval -1
	}

	try_files {path} /index.html
}
