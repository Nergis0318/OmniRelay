{
  "name": "hybrid_search",
  "description": "BEST default search. Combines FFF file search + vector semantic search + call graph traversal. Use for any codebase exploration task.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "maxResults": {
        "format": "double",
        "type": [
          "number",
          "null"
        ]
      },
      "path": {
        "description": "Optional file path constraint.",
        "type": [
          "string",
          "null"
        ]
      },
      "query": {
        "description": "Search query (natural language or identifier).",
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "type": "object"
  }
}