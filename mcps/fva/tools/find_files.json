{
  "name": "find_files",
  "description": "Fuzzy file search by path/name. Frecency-ranked, git-aware. Use when exploring which files exist.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "maxResults": {
        "format": "double",
        "type": [
          "number",
          "null"
        ]
      },
      "offset": {
        "format": "double",
        "type": [
          "number",
          "null"
        ]
      },
      "query": {
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "type": "object"
  }
}