# OmniRelay Environment Configuration
# Copy this file to .env and update the values as needed.

# Server listen address (default: :8080)
LISTEN_ADDR=:8080

# SQLite database path (default: data/omnirelay.db)
DATABASE_PATH=data/omnirelay.db

# Secret key for JWT token signing (change in production)
JWT_SECRET=

# 32-byte hex-encoded key for encrypting stored secrets (change in production)
# Generate with: openssl rand -hex 32
ENCRYPT_KEY=

# Comma-separated list of allowed CORS origins (default: http://localhost:5173,http://localhost:3000)
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=
